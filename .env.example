# =====================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =====================================================================

# Puerto en el que corre el servidor
PORT=3000

# Entorno de ejecución (development, production, test)
NODE_ENV='development'

# =====================================================================
# BASE DE DATOS - PostgreSQL (Prisma)
# =====================================================================

# URL de conexión a PostgreSQL (usado en desarrollo)
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/ecommerce"

# URL de conexión directa a PostgreSQL (usado en producción con Supabase)
DIRECT_URL="postgresql://usuario:contraseña@db.supabase.co:5432/postgres"

# =====================================================================
# BASE DE DATOS - MongoDB
# =====================================================================

# URI de conexión a MongoDB (para reviews, wishlist, logs)
MONGO_URI="mongodb+srv://usuario:contraseña@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority"

# =====================================================================
# AUTENTICACIÓN - JWT
# =====================================================================

# Secreto para firmar los JWT (cambiar en producción)
JWT_SECRET="tu-secreto-super-secreto-y-seguro-aqui-minimo-32-caracteres"

# =====================================================================
# ALMACENAMIENTO - Cloudinary
# =====================================================================

# Nombre de tu cuenta en Cloudinary
CLOUDINARY_CLOUD_NAME="tu-cloud-name"

# API Key de Cloudinary
CLOUDINARY_API_KEY="tu-api-key"

# API Secret de Cloudinary
CLOUDINARY_API_SECRET="tu-api-secret"

# Api Key de Stripe
STRIPE_SECRET_KEY='tu-api-key'

# Api Key pública de Stripe
STRIPE_PUBLIC_KEY='tu-api-key'

# Api Key de Webhook para Stripe
STRIPE_WEBHOOK_SECRET='tu-api-key'

# URL al frontend
FRONTEND_URL='http://localhost:5173'

# =====================================================================
# CORS - Orígenes permitidos (separados por comas)
# =====================================================================

# Por defecto permite: http://localhost:3000, http://127.0.0.1:3000, 
#                      http://localhost:5173, http://127.0.0.1:5173
# 
# Para personalizar, descomenta y modifica:
# CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://tu-dominio.com"

# =====================================================================
# NOTAS
# =====================================================================

# En desarrollo:
#   - DATABASE_URL puede apuntar a PostgreSQL local
#   - MONGO_URI puede apuntar a MongoDB local o Atlas
#   - CORS_ORIGINS usa localhost

# En producción:
#   - DATABASE_URL / DIRECT_URL apuntan a Supabase
#   - MONGO_URI apunta a MongoDB Atlas
#   - CORS_ORIGINS incluye tu dominio de producción
#   - JWT_SECRET es un valor seguro y único
#   - NODE_ENV="production"
